# Snake Web static artifacts. Installed once; preserved on reinstall/upgrade.
# Serve this directory with Caddy; see docs/devops/static-publishing.md.
PUBLISH_DIRECTORY=/var/lib/snake-web/public
# Snake Lab capture service (Ax3l-compatible version-1 ZMQ protocol).
# SNAKE_LAB_ENDPOINT=tcp://127.0.0.1:41970
