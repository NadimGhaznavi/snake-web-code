[Unit]
Description=Snake Web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snake-web
Group=snake-web
WorkingDirectory=/opt/prod/snake-web
Environment=HOME=/var/lib/snake-web
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/snake-web/snake-web.env
EnvironmentFile=/etc/snake-web/database.env
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/opt/prod/snake-web/venv/bin/python -m snake_web.server
StateDirectory=snake-web
StateDirectoryMode=0750
RuntimeDirectory=snake-web
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
